{
  "name": "@o9nn/core",
  "version": "0.1.0",
  "description": "o9nn Core - Shared utilities and common types for the o9nn monorepo",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.mjs",
      "require": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.mjs",
      "require": "./dist/utils/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/types/index.ts src/utils/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/types/index.ts src/utils/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "test": "vitest",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "o9nn",
    "core",
    "utilities",
    "types",
    "ai",
    "ml"
  ],
  "author": "o9nn Organization",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/o9nn/dro9nn.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/o9nn/dro9nn/issues"
  },
  "homepage": "https://github.com/o9nn/dro9nn/tree/main/packages/core#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  }
}
