{
  "name": "@o9nn/gnn",
  "version": "0.1.0",
  "description": "Graph Neural Network Hub - Unified GNN API for the o9nn ecosystem",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/ --ext .ts,.tsx",
    "test": "vitest",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "o9nn",
    "gnn",
    "graph-neural-network",
    "gcn",
    "gat",
    "graphsage",
    "deep-learning",
    "machine-learning"
  ],
  "author": "o9nn Organization",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/o9nn/dro9nn.git",
    "directory": "packages/gnn"
  },
  "bugs": {
    "url": "https://github.com/o9nn/dro9nn/issues"
  },
  "homepage": "https://github.com/o9nn/dro9nn/tree/main/packages/gnn#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@o9nn/core": "workspace:*",
    "@o9nn/ml-core": "workspace:*"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^7.18.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.1"
  }
}
