            "from typing import Any",
            "from o9nn_sdk import create_tool",
            "",
            "",
            "def ${1:tool_name}_execute(params: dict[str, Any]) -> str:",
            "    \"\"\"",
            "    Execute the ${1:tool_name} tool.",
            "    ",
            "    Args:",
            "        params: Tool parameters",
            "        ",
            "    Returns:",
            "        Tool result",
            "    \"\"\"",
            "    ${2:# TODO: Implement tool logic}",
            "    return f\"Result: {params}\"",
            "",
            "",
            "${1:tool_name}_tool = create_tool(",
            "    name=\"${1:tool_name}\",",
            "    description=\"${3:Description of the tool}\",",
            "    parameters={",
            "        \"type\": \"object\",",
            "        \"properties\": {",
            "            \"${4:input}\": {",
            "                \"type\": \"string\",",
            "                \"description\": \"${5:Input parameter}\"",
            "            }",
            "        },",
            "        \"required\": [\"${4:input}\"]",
            "    },",
            "    execute=${1:tool_name}_execute,",
            ")"
        ],
        "description": "Create a new o9nn tool"
    },
