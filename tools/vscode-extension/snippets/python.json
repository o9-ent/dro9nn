{
    "o9nn Agent Python": {
        "prefix": "o9nn-agent",
        "body": [
            "\"\"\"",
            "${1:Agent} - o9nn Agent",
            "\"\"\"",
            "",
            "from o9nn_sdk import AgentBuilder, create_tool, create_sdk",
            "",
            "",
            "class ${1:Agent}:",
            "    \"\"\"${2:Description of the agent}.\"\"\"",
            "    ",
            "    def __init__(self, model: str = \"llama-2-7b-chat\"):",
            "        self.sdk = create_sdk()",
            "        self.model = model",
            "        self.agent = None",
            "    ",
            "    def setup(self):",
            "        \"\"\"Configure and build the agent.\"\"\"",
            "        self.agent = (",
            "            AgentBuilder(\"${3:agent-name}\")",
            "            .with_model({\"name\": self.model, \"backend\": \"llama.cpp\"})",
            "            .with_system_prompt(\"${4:You are a helpful assistant.}\")",
            "            .build()",
            "        )",
            "        return self",
            "    ",
            "    async def chat(self, message: str) -> str:",
            "        \"\"\"Send a message to the agent.\"\"\"",
            "        if self.agent is None:",
            "            raise RuntimeError(\"Agent not initialized\")",
            "        response = await self.agent.chat(message)",
            "        return response.content",
            "",
            "",
            "if __name__ == \"__main__\":",
            "    agent = ${1:Agent}().setup()",
            "    print(f\"Agent ready: {agent.model}\")"
        ],
        "description": "Create a new o9nn agent class"
    },
    "o9nn Tool Python": {
