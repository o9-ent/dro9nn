    "o9nn Model Inference": {
        "prefix": "o9nn-infer",
        "body": [
            "from o9nn_sdk import create_sdk, GenerationOptions",
            "",
            "async def run_inference():",
            "    sdk = create_sdk()",
            "    ",
            "    options = GenerationOptions(",
            "        max_tokens=${1:256},",
            "        temperature=${2:0.7},",
            "    )",
            "    ",
            "    response = await sdk.models.infer(",
            "        model=\"${3:llama-2-7b-chat}\",",
            "        prompt=\"${4:Hello, world!}\",",
            "        options=options,",
            "    )",
            "    ",
            "    print(response.text)"
        ],
        "description": "Run model inference"
    }
}
