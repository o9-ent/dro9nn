{
    "o9nn Agent Go": {
        "prefix": "o9nn-agent",
        "body": [
            "package ${1:agent}",
            "",
            "import (",
            "\t\"context\"",
            "\t\"fmt\"",
            "",
            "\tcogsdk \"github.com/o9nn/dro9nn/packages/sdk/go\"",
            ")",
            "",
            "// ${2:AgentName} implements an o9nn agent.",
            "type ${2:AgentName} struct {",
            "\tclient *cogsdk.Client",
            "\tmodel  string",
            "\tagent  *cogsdk.AgentInfo",
            "}",
            "",
            "// New${2:AgentName} creates a new agent instance.",
            "func New${2:AgentName}(cfg *cogsdk.Config, model string) (*${2:AgentName}, error) {",
            "\tclient := cogsdk.NewClient(cfg)",
            "\tif model == \"\" {",
            "\t\tmodel = \"llama-2-7b-chat\"",
            "\t}",
            "\treturn &${2:AgentName}{",
            "\t\tclient: client,",
            "\t\tmodel:  model,",
            "\t}, nil",
            "}",
            "",
            "// Setup configures and creates the agent.",
            "func (a *${2:AgentName}) Setup(ctx context.Context) error {",
            "\tconfig := cogsdk.AgentConfig{",
            "\t\tName:  \"${3:agent-name}\",",
            "\t\tModel: a.model,",
            "\t}",
            "",
            "\tagent, err := a.client.Agents().Create(ctx, config)",
            "\tif err != nil {",
            "\t\treturn fmt.Errorf(\"failed to create agent: %w\", err)",
            "\t}",
            "",
            "\ta.agent = agent",
            "\treturn nil",
            "}",
            "",
            "// Chat sends a message and returns the response.",
            "func (a *${2:AgentName}) Chat(ctx context.Context, message string) (string, error) {",
            "\tif a.agent == nil {",
            "\t\treturn \"\", fmt.Errorf(\"agent not initialized\")",
            "\t}",
            "",
            "\tresp, err := a.client.Agents().Send(ctx, a.agent.ID, message)",
            "\tif err != nil {",
            "\t\treturn \"\", err",
            "\t}",
            "",
            "\treturn resp.Message.Content, nil",
            "}"
        ],
        "description": "Create a new o9nn agent"
    },
    "o9nn SDK Client Go": {
        "prefix": "o9nn-client",
        "body": [
            "import cogsdk \"github.com/o9nn/dro9nn/packages/sdk/go\"",
            "",
            "config := &cogsdk.Config{",
            "\tBaseURL: \"${1:http://localhost:8080}\",",
            "\tAPIKey:  \"${2:your-api-key}\",",
            "}",
            "",
            "client := cogsdk.NewClient(config)"
        ],
        "description": "Initialize o9nn SDK client"
    },
    "o9nn Model Inference Go": {
        "prefix": "o9nn-infer",
        "body": [
            "import (",
            "\t\"context\"",
            "\t\"fmt\"",
            "",
            "\tcogsdk \"github.com/o9nn/dro9nn/packages/sdk/go\"",
            ")",
            "",
            "func runInference() error {",
            "\tctx := context.Background()",
            "\tclient := cogsdk.NewClient(nil)",
            "",
            "\treq := cogsdk.InferenceRequest{",
            "\t\tModel:  \"${1:llama-2-7b-chat}\",",
            "\t\tPrompt: \"${2:Hello, world!}\",",
            "\t}",
            "",
            "\tresp, err := client.Models().Infer(ctx, req)",
            "\tif err != nil {",
            "\t\treturn err",
            "\t}",
            "",
            "\tfmt.Println(resp.Text)",
            "\treturn nil",
            "}"
        ],
        "description": "Run model inference"
    }
}
