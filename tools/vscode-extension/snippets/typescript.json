{
    "o9nn Agent TypeScript": {
        "prefix": "o9nn-agent",
        "body": [
            "/**",
            " * ${1:Agent} - o9nn Agent",
            " */",
            "",
            "import { createCogSDK, AgentBuilder, Tool } from '@o9nn/cog-sdk';",
            "",
            "export class ${1:Agent} {",
            "  private sdk = createCogSDK();",
            "  private model: string;",
            "  private agent: any;",
            "",
            "  constructor(model: string = 'llama-2-7b-chat') {",
            "    this.model = model;",
            "  }",
            "",
            "  async setup(): Promise<this> {",
            "    this.agent = await new AgentBuilder('${2:agent-name}')",
            "      .withModel({ name: this.model, backend: 'llama.cpp' })",
            "      .withSystemPrompt('${3:You are a helpful assistant.}')",
            "      .build();",
            "    return this;",
            "  }",
            "",
            "  async chat(message: string): Promise<string> {",
            "    if (!this.agent) {",
            "      throw new Error('Agent not initialized');",
            "    }",
            "    const response = await this.agent.chat(message);",
            "    return response.content;",
            "  }",
            "}",
            "",
            "// Usage",
            "async function main() {",
            "  const agent = await new ${1:Agent}().setup();",
            "  console.log('Agent ready:', agent);",
            "}",
            "",
            "main().catch(console.error);"
        ],
        "description": "Create a new o9nn agent class"
    },
    "o9nn Tool TypeScript": {
        "prefix": "o9nn-tool",
        "body": [
            "import { Tool, ToolParameters } from '@o9nn/cog-sdk';",
            "",
            "interface ${1:ToolName}Params {",
            "  ${2:input}: string;",
            "}",
            "",
            "async function execute(params: ${1:ToolName}Params): Promise<string> {",
            "  ${3:// TODO: Implement tool logic}",
            "  return `Result: ${JSON.stringify(params)}`;",
            "}",
            "",
            "export const ${1/(.*)/${1:/camelcase}/}Tool: Tool = {",
            "  name: '${1/(.*)/${1:/downcase}/}',",
            "  description: '${4:Description of the tool}',",
            "  parameters: {",
            "    type: 'object',",
            "    properties: {",
            "      ${2:input}: {",
            "        type: 'string',",
            "        description: '${5:Input parameter}',",
            "      },",
            "    },",
            "    required: ['${2:input}'],",
            "  } as ToolParameters,",
            "  execute,",
            "};"
        ],
        "description": "Create a new o9nn tool"
    },
    "o9nn SDK Client": {
        "prefix": "o9nn-client",
        "body": [
            "import { createCogSDK } from '@o9nn/cog-sdk';",
            "",
            "const sdk = createCogSDK({",
            "  baseUrl: '${1:http://localhost:8080}',",
            "  apiKey: '${2:your-api-key}',",
            "});"
        ],
        "description": "Initialize o9nn SDK client"
    },
    "o9nn Model Inference": {
        "prefix": "o9nn-infer",
        "body": [
            "import { createCogSDK } from '@o9nn/cog-sdk';",
            "",
            "async function runInference() {",
            "  const sdk = createCogSDK();",
            "",
            "  const response = await sdk.models.infer({",
            "    model: '${1:llama-2-7b-chat}',",
            "    prompt: '${2:Hello, world!}',",
            "    maxTokens: ${3:256},",
            "    temperature: ${4:0.7},",
            "  });",
            "",
            "  console.log(response.text);",
            "}",
            "",
            "runInference();"
        ],
        "description": "Run model inference"
    }
}
